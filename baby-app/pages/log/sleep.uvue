<template>
  <view class="page-root">
    <!-- Status Bar -->
    <view class="status-bar">
      <text class="status-time">10:38</text>
      <view class="status-icons">
        <view class="status-icon">
          <uni-icons type="signal" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="wifi" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="battery-three-quarters" :size="17" color="#1f2937"></uni-icons>
        </view>
      </view>
    </view>

    <!-- Main Content -->
    <scroll-view class="page-scroll" :show-scrollbar="false">
      <!-- Header -->
      <view class="header-indigo">
        <view class="header-nav">
          <view class="nav-back" @tap="goBack">
            <uni-icons type="back" :size="20" color="#ffffff"></uni-icons>
          </view>
          <text class="nav-title">睡眠追踪</text>
          <text class="nav-action">历史</text>
        </view>
        <view class="header-content">
          <text class="header-title">睡眠记录</text>
          <text class="header-desc">记录白天和夜间睡眠，帮助观察作息节奏是否稳定。</text>
        </view>
      </view>

      <!-- Content Section -->
      <view class="content-section">
        <!-- Sleep Type -->
        <view class="card">
          <text class="card-title">睡眠类型</text>
          <view class="grid-2 mt-3">
            <view class="grid-btn grid-btn-active" @tap="selectType('day')">
              <text>白天睡眠</text>
            </view>
            <view class="grid-btn" @tap="selectType('night')">
              <text>夜间睡眠</text>
            </view>
          </view>
        </view>

        <!-- Time Range -->
        <view class="card">
          <text class="card-title">时间区间</text>
          <view class="time-grid mt-3">
            <view class="time-block time-block-active">
              <text class="time-label">开始入睡</text>
              <text class="time-value">13:10</text>
            </view>
            <view class="time-block">
              <text class="time-label">醒来时间</text>
              <text class="time-value time-value-gray">14:45</text>
            </view>
          </view>
          <view class="duration-block">
            <text class="duration-label">本次总时长</text>
            <text class="duration-value">1 小时 35 分</text>
          </view>
        </view>

        <!-- Sleep Quality -->
        <view class="card">
          <view class="card-header">
            <text class="card-title">睡眠质量</text>
            <text class="card-badge">本周平均 9.8h/天</text>
          </view>
          <view class="quality-grid mt-3">
            <view class="quality-btn quality-btn-active" @tap="selectQuality('fallAsleep')">
              <text>入睡快</text>
            </view>
            <view class="quality-btn" @tap="selectQuality('wakeEasy')">
              <text>易惊醒</text>
            </view>
            <view class="quality-btn" @tap="selectQuality('cry')">
              <text>哭闹</text>
            </view>
          </view>
        </view>

        <!-- Before Sleep Status -->
        <view class="card">
          <text class="card-title">入睡前状态</text>
          <view class="status-list mt-3">
            <view class="status-item">
              <text class="status-label">已喂奶</text>
              <uni-icons type="checkmark" :size="18" color="#22c55e"></uni-icons>
            </view>
            <view class="status-item">
              <text class="status-label">白噪音辅助</text>
              <uni-icons type="checkmark" :size="18" color="#22c55e"></uni-icons>
            </view>
            <view class="status-item status-item-dashed">
              <text class="status-placeholder">补充备注：入睡前玩耍较兴奋、换了睡袋等</text>
            </view>
          </view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- Bottom Actions -->
    <view class="bottom-bar">
      <view class="btn btn-secondary" @tap="goBack">
        <text>取消</text>
      </view>
      <view class="btn btn-primary btn-wide" @tap="saveRecord">
        <text>保存睡眠记录</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  let selectedType = ref('day')
  let selectedQuality = ref('fallAsleep')

  function goBack() {
    uni.navigateBack()
  }

  function selectType(type: string) {
    selectedType.value = type
  }

  function selectQuality(quality: string) {
    selectedQuality.value = quality
  }

  function saveRecord() {
    uni.showToast({
      title: '保存成功',
      icon: 'success'
    })
    setTimeout(() => {
      uni.switchTab({
        url: '/pages/home/index'
      })
    }, 1500)
  }
</script>

