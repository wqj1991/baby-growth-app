<script setup lang="uts">
  function goBack() {
    uni.navigateBack({
      fail: () => {
        uni.redirectTo({
          url: '/pages/home/index'
        })
      }
    })
  }

  function goHome() {
    uni.redirectTo({
      url: '/pages/home/index',
      fail: () => {
        uni.reLaunch({
          url: '/pages/home/index'
        })
      }
    })
  }

  function showToast(title: string) {
    uni.showToast({
      title,
      icon: 'none'
    })
  }
</script>

