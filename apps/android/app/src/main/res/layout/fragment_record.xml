<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".ui.record.RecordFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_4">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="记录宝宝的今天"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_size_2xl"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_1"
            android:text="选择一种方式开始记录吧"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/font_size_sm" />

        <!-- Action Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_6"
            android:columnCount="2">

            <!-- Camera -->
            <LinearLayout
                android:id="@+id/cameraButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/spacing_2"
                android:background="@drawable/gradient_background_camera"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_2"
                    android:text="拍照/录像"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="同步到网盘"
                    android:textColor="@color/white"
                    android:textSize="@dimen/font_size_xs"
                    android:alpha="0.8" />
            </LinearLayout>

            <!-- Upload -->
            <LinearLayout
                android:id="@+id/uploadButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="@dimen/spacing_2"
                android:background="@drawable/gradient_background_upload"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_upload"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_2"
                    android:text="本地上传"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="仅备份到网盘"
                    android:textColor="@color/white"
                    android:textSize="@dimen/font_size_xs"
                    android:alpha="0.8" />
            </LinearLayout>
        </GridLayout>

        <!-- Divider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_8"
            android:layout_marginBottom="@dimen/spacing_8"
            android:text="或快速记录日常"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/font_size_sm"
            android:textStyle="bold" />

        <!-- Quick Log Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:divider="@drawable/divider_space"
            android:showDividers="middle">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logFeedingButton"
                style="@style/Widget.App.Button.QuickLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="喂养"
                app:icon="@drawable/ic_feeding" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logPottyButton"
                style="@style/Widget.App.Button.QuickLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="大小便"
                app:icon="@drawable/ic_potty" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logSleepButton"
                style="@style/Widget.App.Button.QuickLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="睡眠"
                app:icon="@drawable/ic_sleep" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logGrowthButton"
                style="@style/Widget.App.Button.QuickLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="身高/体重"
                app:icon="@drawable/ic_growth" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logHealthButton"
                style="@style/Widget.App.Button.QuickLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="更多健康记录"
                app:icon="@drawable/ic_health" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
