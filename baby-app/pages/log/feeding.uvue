<template>
  <view class="page-root">
    <!-- Status Bar -->
    <view class="status-bar">
      <text class="status-time">10:36</text>
      <view class="status-icons">
        <view class="status-icon">
          <uni-icons type="signal" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="wifi" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="battery-three-quarters" :size="17" color="#1f2937"></uni-icons>
        </view>
      </view>
    </view>

    <!-- Main Content -->
    <scroll-view class="page-scroll" :show-scrollbar="false">
      <!-- Header -->
      <view class="header-sky">
        <view class="header-nav">
          <view class="nav-back" @tap="goBack">
            <uni-icons type="back" :size="20" color="#ffffff"></uni-icons>
          </view>
          <text class="nav-title">快速记录</text>
          <text class="nav-action">草稿</text>
        </view>
        <view class="header-content">
          <view class="header-badge">
            <uni-icons type="bottle-droplet" :size="12" color="#ffffff"></uni-icons>
            <text>今日第 5 次喂养</text>
          </view>
          <text class="header-title">喂养记录</text>
          <text class="header-desc">快速补充奶量、辅食和宝宝状态，保存后会同步到时间轴。</text>
        </view>
      </view>

      <!-- Content Section -->
      <view class="content-section">
        <!-- Feeding Type -->
        <view class="card">
          <view class="card-header">
            <text class="card-title">喂养类型</text>
            <text class="card-link" @tap="goFeedingTypes">去我的里配置</text>
          </view>
          <view class="type-grid mt-3">
            <view class="type-btn type-btn-active" @tap="selectType('milk')">
              <text>奶粉</text>
            </view>
            <view class="type-btn" @tap="selectType('breast')">
              <text>母乳</text>
            </view>
            <view class="type-btn" @tap="selectType('solid')">
              <text>辅食</text>
            </view>
          </view>
          <view class="sync-note mt-3">
            <text>已同步你的配置：奶粉、母乳、辅食、喝水。最近新增的"喝水"会在下一次记录时优先展示。</text>
          </view>
        </view>

        <!-- Feeding Amount -->
        <view class="card">
          <view class="card-header">
            <text class="card-title">喂养量</text>
            <text class="card-badge">建议范围 150 - 210 ml</text>
          </view>
          <view class="amount-display mt-4">
            <view class="amount-row">
              <text class="amount-value">180</text>
              <text class="amount-unit">ml</text>
            </view>
            <slider class="amount-slider" min="30" max="300" value="180" step="5" @change="onAmountChange" />
          </view>
          <view class="amount-stats mt-4">
            <view class="stat-item">
              <text>上次 160 ml</text>
            </view>
            <view class="stat-item">
              <text>平均 175 ml</text>
            </view>
            <view class="stat-item">
              <text>间隔 3 小时</text>
            </view>
          </view>
        </view>

        <!-- Record Time -->
        <view class="card">
          <text class="card-title">记录时间</text>
          <view class="time-row mt-3">
            <view class="time-block">
              <text class="time-label">开始</text>
              <text class="time-value">10:20</text>
            </view>
            <view class="time-block">
              <text class="time-label">时长</text>
              <text class="time-value">18 分钟</text>
            </view>
          </view>
        </view>

        <!-- Baby Status -->
        <view class="card">
          <text class="card-title">宝宝状态</text>
          <view class="status-tags mt-3">
            <view class="status-tag status-tag-active" @tap="toggleStatus('good')">
              <text>胃口不错</text>
            </view>
            <view class="status-tag" @tap="toggleStatus('slow')">
              <text>喝得有点慢</text>
            </view>
            <view class="status-tag" @tap="toggleStatus('burp')">
              <text>喂后拍嗝</text>
            </view>
            <view class="status-tag" @tap="toggleStatus('spit')">
              <text>有吐奶</text>
            </view>
          </view>
          <view class="notes-dashed mt-4">
            <text>补充备注：例如换了新奶粉、辅食接受度更高等</text>
          </view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- Bottom Actions -->
    <view class="bottom-bar">
      <view class="btn btn-secondary" @tap="goBack">
        <text>取消</text>
      </view>
      <view class="btn btn-primary btn-wide" @tap="saveRecord">
        <text>保存喂养记录</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  let selectedType = ref('milk')
  let selectedStatuses = ref<string[]>(['good'])
  let amount = ref(180)

  function goBack() {
    uni.navigateBack()
  }

  function goFeedingTypes() {
    uni.showToast({
      title: '去我的里配置',
      icon: 'none'
    })
  }

  function selectType(type: string) {
    selectedType.value = type
  }

  function onAmountChange(e: { detail: { value: number } }) {
    amount.value = e.detail.value
  }

  function toggleStatus(status: string) {
    const index = selectedStatuses.value.indexOf(status)
    if (index > -1) {
      selectedStatuses.value.splice(index, 1)
    } else {
      selectedStatuses.value.push(status)
    }
  }

  function saveRecord() {
    uni.showToast({
      title: '保存成功',
      icon: 'success'
    })
    setTimeout(() => {
      uni.switchTab({
        url: '/pages/home/index'
      })
    }, 1500)
  }
</script>

