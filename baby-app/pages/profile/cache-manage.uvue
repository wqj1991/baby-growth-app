        </view>
        <view class="status-icon">
          <uni-icons type="wifi" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="battery-full" :size="17" color="#1f2937"></uni-icons>
        </view>
      </view>
    </view>

    <!-- Main Content -->
    <scroll-view class="page-scroll" :show-scrollbar="false">
      <!-- Header -->
      <view class="header-teal">
        <view class="header-nav">
          <view class="nav-back" @tap="goBack">
            <uni-icons type="back" :size="20" color="#ffffff"></uni-icons>
          </view>
          <text class="nav-title">本地存储</text>
          <text class="nav-action">优化</text>
        </view>
        <view class="header-content">
          <text class="header-title">缓存管理</text>
          <text class="header-desc">管理预览缓存、自动清理规则与离线可用内容。</text>
        </view>
      </view>

      <!-- Content Section -->
      <view class="content-section">
        <!-- Cache Usage -->
        <view class="card">
          <view class="card-header">
            <text class="card-title">缓存使用</text>
            <text class="card-badge">1.36 / 2.00 GB</text>
          </view>
          <view class="progress-bar">
            <view class="progress-fill"></view>
          </view>
          <view class="usage-grid">
            <view class="usage-item usage-item-teal">
              <text class="usage-value">0.72 GB</text>
              <text class="usage-label">图片预览</text>
            </view>
            <view class="usage-item usage-item-cyan">
              <text class="usage-value">0.48 GB</text>
              <text class="usage-label">视频封面</text>
            </view>
            <view class="usage-item usage-item-sky">
              <text class="usage-value">0.16 GB</text>
              <text class="usage-label">元数据</text>
            </view>
          </view>
        </view>

        <!-- Cleanup Strategy -->
        <view class="card">
          <text class="card-title">清理策略</text>
          <view class="switch-list">
            <view class="switch-item">
              <text class="switch-label">超过 7 天自动清理</text>
              <uni-icons type="switch" :size="28" color="#22c55e"></uni-icons>
            </view>
            <view class="switch-item">
              <text class="switch-label">低电量暂停预加载</text>
              <uni-icons type="switch" :size="28" color="#22c55e"></uni-icons>
            </view>
            <view class="switch-item">
              <text class="switch-label">仅 Wi-Fi 预热封面</text>
              <uni-icons type="switch" :size="28" color="#22c55e"></uni-icons>
            </view>
          </view>
        </view>

        <!-- Manual Actions -->
        <view class="card">
          <text class="card-title">手动操作</text>
          <view class="action-list">
            <view class="action-item" @tap="cleanExpired">
              <text class="action-label">清理过期缓存</text>
              <uni-icons type="trash" :size="16" color="#14b8a6"></uni-icons>
            </view>
            <view class="action-item" @tap="releaseSpace">
              <text class="action-label">一键释放 500MB</text>
              <uni-icons type="trash" :size="16" color="#14b8a6"></uni-icons>
            </view>
            <view class="action-item" @tap="rebuildIndex">
              <text class="action-label">重建本地索引</text>
              <uni-icons type="database" :size="16" color="#14b8a6"></uni-icons>
            </view>
          </view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- Bottom Actions -->
    <view class="bottom-bar">
      <view class="btn btn-secondary" @tap="goBack">
        <text>返回我的</text>
      </view>
      <view class="btn btn-primary btn-wide" @tap="saveSettings">
        <text>保存缓存策略</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  function goBack() {
    uni.navigateBack()
  }

  function cleanExpired() {
    uni.showToast({
      title: '清理中...',
      icon: 'loading'
    })
  }

  function releaseSpace() {
    uni.showToast({
      title: '释放空间中...',
      icon: 'loading'
    })
  }

  function rebuildIndex() {
    uni.showToast({
      title: '重建索引中...',
      icon: 'loading'
    })
  }

  function saveSettings() {
    uni.showToast({
      title: '保存成功',
      icon: 'success'
    })
    setTimeout(() => {
      uni.navigateBack()
    }, 1500)
  }
</script>

