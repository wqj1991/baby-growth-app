<template>
  <view class="page-root">
    <!-- Status Bar -->
    <view class="status-bar">
      <text class="status-time">10:50</text>
      <view class="status-icons">
        <view class="status-icon">
          <uni-icons type="signal" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="wifi" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="battery-full" :size="17" color="#1f2937"></uni-icons>
        </view>
      </view>
    </view>

    <!-- Main Content -->
    <scroll-view class="page-scroll" :show-scrollbar="false">
      <!-- Header -->
      <view class="header-rose">
        <view class="header-nav">
          <view class="nav-back" @tap="goBack">
            <uni-icons type="back" :size="20" color="#ffffff"></uni-icons>
          </view>
          <text class="nav-title">健康记录</text>
          <text class="nav-action">模板</text>
        </view>
        <view class="header-content">
          <text class="header-title">体温记录</text>
          <text class="header-desc">记录测温方式、温度数值和处理措施，适合发热追踪。</text>
        </view>
      </view>

      <!-- Content Section -->
      <view class="content-section">
        <!-- Current Temperature -->
        <view class="card">
          <view class="card-header">
            <text class="card-title">当前温度</text>
            <text class="card-badge">高于日常均值</text>
          </view>
          <view class="temp-display mt-4">
            <text class="temp-value">38.2</text>
            <text class="temp-unit">°C</text>
          </view>
          <slider class="temp-slider" min="35" max="41" value="38.2" step="0.1" @change="onTempChange" />
          <view class="temp-stats mt-3">
            <view class="stat-item">
              <text>上次 37.6°C</text>
            </view>
            <view class="stat-item">
              <text>今日第 3 次</text>
            </view>
            <view class="stat-item">
              <text>间隔 2h</text>
            </view>
          </view>
        </view>

        <!-- Measurement Method -->
        <view class="card">
          <text class="card-title">测量方式</text>
          <view class="method-grid mt-3">
            <view class="method-btn method-btn-active" @tap="selectMethod('ear')">
              <text>耳温</text>
            </view>
            <view class="method-btn" @tap="selectMethod('forehead')">
              <text>额温</text>
            </view>
            <view class="method-btn" @tap="selectMethod('armpit')">
              <text>腋温</text>
            </view>
          </view>
        </view>

        <!-- Accompanying Symptoms -->
        <view class="card">
          <text class="card-title">伴随情况</text>
          <view class="symptom-tags mt-3">
            <view class="symptom-tag symptom-tag-active" @tap="toggleSymptom('normal')">
              <text>精神一般</text>
            </view>
            <view class="symptom-tag" @tap="toggleSymptom('poorAppetite')">
              <text>食欲下降</text>
            </view>
            <view class="symptom-tag" @tap="toggleSymptom('物理降温')">
              <text>已物理降温</text>
            </view>
            <view class="symptom-tag" @tap="toggleSymptom('已服药')">
              <text>已服药</text>
            </view>
          </view>
          <view class="notes-dashed mt-4">
            <text>备注：是否精神差、是否寒战、是否刚睡醒等</text>
          </view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- Bottom Actions -->
    <view class="bottom-bar">
      <view class="btn btn-secondary" @tap="goBack">
        <text>取消</text>
      </view>
      <view class="btn btn-primary btn-wide" @tap="saveRecord">
        <text>保存体温记录</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  let temperature = ref(38.2)
  let selectedMethod = ref('ear')
  let selectedSymptoms = ref<string[]>(['normal'])

  function goBack() {
    uni.navigateBack()
  }

  function onTempChange(e: { detail: { value: number } }) {
    temperature.value = e.detail.value
  }

  function selectMethod(method: string) {
    selectedMethod.value = method
  }

  function toggleSymptom(symptom: string) {
    const index = selectedSymptoms.value.indexOf(symptom)
    if (index > -1) {
      selectedSymptoms.value.splice(index, 1)
    } else {
      selectedSymptoms.value.push(symptom)
    }
  }

  function saveRecord() {
    uni.showToast({
      title: '保存成功',
      icon: 'success'
    })
    setTimeout(() => {
      uni.switchTab({
        url: '/pages/home/index'
      })
    }, 1500)
  }
</script>

<style>
