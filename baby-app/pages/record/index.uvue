    <!-- Main Content -->
    <scroll-view class="page-scroll" :show-scrollbar="false">
      <!-- Header -->
      <view class="header">
        <text class="header-title">记录宝宝的今天</text>
        <text class="header-subtitle">选择一种方式开始记录吧</text>
      </view>

      <!-- Action Grid -->
      <view class="action-grid">
        <!-- Camera -->
        <view class="action-card action-card-purple" @tap="handleCamera">
          <view class="action-icon">
            <uni-icons type="camera-filled" :size="48" color="#ffffff"></uni-icons>
          </view>
          <text class="action-title">拍照/录像</text>
          <text class="action-desc">同步到网盘</text>
        </view>

        <!-- Upload -->
        <view class="action-card action-card-teal" @tap="handleUpload">
          <view class="action-icon">
            <uni-icons type="cloud-upload" :size="48" color="#ffffff"></uni-icons>
          </view>
          <text class="action-title">本地上传</text>
          <text class="action-desc">仅备份到网盘</text>
        </view>
      </view>

      <!-- Divider -->
      <view class="divider">
        <text class="divider-text">或快速记录日常</text>
      </view>

      <!-- Quick Log Buttons -->
      <view class="log-list">
        <view v-if="settings.feeding" class="log-item" @tap="goFeedingLog">
          <view class="log-icon log-icon-blue">
            <uni-icons type="wallet-filled" :size="24" color="#3b82f6"></uni-icons>
          </view>
          <text class="log-label">喂养</text>
          <view class="log-arrow">
            <uni-icons type="right" :size="16" color="#9ca3af"></uni-icons>
          </view>
        </view>

        <view v-if="settings.potty" class="log-item" @tap="goPottyLog">
          <view class="log-icon log-icon-amber">
            <uni-icons type="circle-filled" :size="24" color="#d97706"></uni-icons>
          </view>
          <text class="log-label">大小便</text>
          <view class="log-arrow">
            <uni-icons type="right" :size="16" color="#9ca3af"></uni-icons>
          </view>
        </view>

        <view v-if="settings.sleep" class="log-item" @tap="goSleepLog">
          <view class="log-icon log-icon-indigo">
            <uni-icons type="calendar" :size="24" color="#6366f1"></uni-icons>
          </view>
          <text class="log-label">睡眠</text>
          <view class="log-arrow">
            <uni-icons type="right" :size="16" color="#9ca3af"></uni-icons>
          </view>
        </view>

        <view v-if="settings.growth" class="log-item" @tap="goGrowthLog">
          <view class="log-icon log-icon-green">
            <uni-icons type="bars" :size="24" color="#22c55e"></uni-icons>
          </view>
          <text class="log-label">身高/体重</text>
          <view class="log-arrow">
            <uni-icons type="right" :size="16" color="#9ca3af"></uni-icons>
          </view>
        </view>

        <view v-if="settings.healthMore" class="log-item" @tap="goHealthMoreLog">
          <view class="log-icon log-icon-red">
            <uni-icons type="medal" :size="24" color="#ef4444"></uni-icons>
          </view>
          <text class="log-label">更多健康记录</text>
          <view class="log-arrow">
            <uni-icons type="right" :size="16" color="#9ca3af"></uni-icons>
          </view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- Bottom Tab Bar -->
    <view class="tab-bar">
