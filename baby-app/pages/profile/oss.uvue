<template>
  <view class="page-root">
    <!-- Status Bar -->
    <view class="status-bar">
      <text class="status-time">10:45</text>
      <view class="status-icons">
        <view class="status-icon">
          <uni-icons type="signal" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="wifi" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="battery-three-quarters" :size="17" color="#1f2937"></uni-icons>
        </view>
      </view>
    </view>

    <!-- Main Content -->
    <scroll-view class="page-scroll" :show-scrollbar="false">
      <!-- Header -->
      <view class="header-sky">
        <view class="header-nav">
          <view class="nav-back" @tap="goBack">
            <uni-icons type="back" :size="20" color="#ffffff"></uni-icons>
          </view>
          <text class="nav-title">云端连接</text>
          <text class="nav-action">保存</text>
        </view>
        <view class="header-content">
          <text class="header-title">阿里云OSS</text>
          <text class="header-desc">管理阿里云OSS连接、同步策略、加密与空间映射。</text>
        </view>
      </view>

      <!-- Content Section -->
      <view class="content-section">
        <!-- OSS Config -->
        <view class="card">
          <text class="card-title">OSS 凭证配置</text>
          <view class="form-list">
            <view class="form-item">
              <text class="form-label">Endpoint</text>
              <input class="form-input" :value="endpoint" @input="onEndpointInput" placeholder="例如 oss-cn-hangzhou.aliyuncs.com" />
            </view>
            <view class="form-item">
              <text class="form-label">Bucket</text>
              <input class="form-input" :value="bucket" @input="onBucketInput" placeholder="例如 baobao-prod" />
            </view>
            <view class="form-item">
              <text class="form-label">AccessKeyId</text>
              <input class="form-input" :value="accessKeyId" @input="onAccessKeyIdInput" placeholder="请输入 AccessKeyId" />
            </view>
            <view class="form-item">
              <text class="form-label">AccessKeySecret</text>
              <input class="form-input" password :value="accessKeySecret" @input="onAccessKeySecretInput" placeholder="请输入 AccessKeySecret" />
            </view>
          </view>
        </view>

        <!-- Connection Status -->
        <view class="card">
          <view class="card-header">
            <text class="card-title">连接状态</text>
            <text class="card-badge">{{ connectionBadge }}</text>
          </view>
          <view class="connection-info">
            <view class="connection-row">
              <text class="connection-label">账号</text>
              <text class="connection-value">{{ accountText }}</text>
            </view>
            <view class="connection-row">
              <text class="connection-label">最后握手</text>
              <text class="connection-value">{{ handshakeText }}</text>
            </view>
            <view class="connection-actions uni-row">
              <view class="action-btn" @tap="reAuth">
                <text>重新鉴权</text>
              </view>
              <view class="action-btn" @tap="checkConnection">
                <text>检测连通性</text>
              </view>
            </view>
          </view>
        </view>

        <!-- Directory Mapping -->
        <view class="card">
          <text class="card-title">目录映射</text>
          <view class="mapping-list">
            <view class="mapping-item">
              <text class="mapping-label">时间轴媒体目录</text>
              <text class="mapping-value">/Baby/Media</text>
            </view>
            <view class="mapping-item">
              <text class="mapping-label">日志目录</text>
              <text class="mapping-value">/Baby/Logs</text>
            </view>
            <view class="mapping-item">
              <text class="mapping-label">配置目录</text>
              <text class="mapping-value">/Baby/Config</text>
            </view>
          </view>
        </view>

        <!-- Sync Strategy -->
        <view class="card">
          <view class="card-header">
            <text class="card-title">同步策略</text>
            <text class="card-badge-sky">按产品规则</text>
          </view>
          <view class="switch-list">
            <view class="switch-item">
              <text class="switch-label">App 启动自动同步</text>
              <uni-icons type="switch" :size="28" color="#22c55e"></uni-icons>
            </view>
            <view class="switch-item">
              <text class="switch-label">下拉刷新触发同步</text>
              <uni-icons type="switch" :size="28" color="#22c55e"></uni-icons>
            </view>
            <view class="switch-item">
              <text class="switch-label">后台每 10 分钟轮询</text>
              <uni-icons type="switch" :size="28" color="#22c55e"></uni-icons>
            </view>
            <view class="switch-item">
              <text class="switch-label">冲突策略</text>
              <text class="switch-value">LWW</text>
            </view>
          </view>
        </view>

        <!-- Security & Cache -->
        <view class="card">
          <text class="card-title">安全与缓存</text>
          <view class="switch-list">
            <view class="switch-item">
              <text class="switch-label">日志/配置加密上传</text>
              <uni-icons type="switch" :size="28" color="#22c55e"></uni-icons>
            </view>
            <view class="switch-item">
              <text class="switch-label">预览缓存上限</text>
              <text class="switch-value">2 GB</text>
            </view>
            <view class="switch-item">
              <text class="switch-label">缓存有效期</text>
              <text class="switch-value">7 天</text>
            </view>
          </view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- Bottom Actions -->
    <view class="bottom-bar uni-row">
      <view class="btn btn-secondary" @tap="goBack">
        <text>返回我的</text>
      </view>
      <view class="btn btn-primary btn-wide" @tap="saveConfig">
        <text>保存OSS配置</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import {
    aliOssStorage,
    connectAliOss,
    checkAliOssConnection,
    validateAliOssRuntimeConfig,
    initializeAliOssProfile
  } from '@/utils/storage'

  const connectionBadge = ref('未连接')
  const accountText = ref('未授权账号')
  const handshakeText = ref('未鉴权')
  const endpoint = ref('')
  const bucket = ref('')
  const accessKeyId = ref('')
  const accessKeySecret = ref('')

  hydrateConfigForm()
  hydrateAuthView()

  function goBack() {
    uni.navigateBack()
  }

  function hydrateAuthView() {
    const runtimeConfig = aliOssStorage.getRuntimeConfig()
    const session = aliOssStorage.getSession()
    const validationMessage = validateAliOssRuntimeConfig(runtimeConfig)

    if (session == null) {
      connectionBadge.value = '未连接'
      accountText.value = '未授权账号'
      handshakeText.value = validationMessage.length > 0 ? validationMessage : '未连接OSS'
      return
    }

    accountText.value = 'AK: ' + session.account

    if (validationMessage.length === 0) {
      connectionBadge.value = '已连接'
      handshakeText.value = '今天 ' + formatClock(new Date())
      return
    }

    connectionBadge.value = '已过期'
    handshakeText.value = validationMessage
  }

  function hydrateConfigForm() {
    const runtimeConfig = aliOssStorage.getRuntimeConfig()
    endpoint.value = runtimeConfig.endpoint
    bucket.value = runtimeConfig.bucket
    accessKeyId.value = runtimeConfig.accessKeyId
    accessKeySecret.value = runtimeConfig.accessKeySecret
  }

  function persistRuntimeConfig() {
    const previous = aliOssStorage.getRuntimeConfig()
    aliOssStorage.setRuntimeConfig({
      ...previous,
      endpoint: endpoint.value.trim(),
      bucket: bucket.value.trim(),
      accessKeyId: accessKeyId.value.trim(),
      accessKeySecret: accessKeySecret.value.trim()
    })
  }

  function inputValue(event: any): string {
    return (event?.detail?.value ?? '') as string
  }

  function onEndpointInput(event: any) {
    endpoint.value = inputValue(event)
  }

  function onBucketInput(event: any) {
    bucket.value = inputValue(event)
  }

  function onAccessKeyIdInput(event: any) {
    accessKeyId.value = inputValue(event)
  }

  function onAccessKeySecretInput(event: any) {
    accessKeySecret.value = inputValue(event)
  }

  async function reAuth() {
    uni.showLoading({
      title: '连接OSS中...'
    })

    try {
      persistRuntimeConfig()
      const session = await connectAliOss()

      hydrateAuthView()
      uni.showToast({
        title: 'OSS连接成功: ' + session.bucket,
        icon: 'success'
      })
    } catch (error) {
      console.error('Ali OSS connect failed:', error)
      uni.showToast({
        title: String(error),
        icon: 'none'
      })
    } finally {
      uni.hideLoading()
    }
  }

  async function checkConnection() {
    uni.showLoading({
      title: '检测连通性...'
    })

    try {
      persistRuntimeConfig()
      const session = await checkAliOssConnection()
      if (session == null) {
        connectionBadge.value = '未连接'
        handshakeText.value = '请先配置并连接OSS'
        uni.showToast({
          title: '请先配置OSS参数',
          icon: 'none'
        })
        return
      }

      hydrateAuthView()
      uni.showToast({
        title: 'OSS连接正常',
        icon: 'success'
      })
    } catch (error) {
      console.error('Check connection failed:', error)
      uni.showToast({
        title: '检测失败',
        icon: 'none'
      })
    } finally {
      uni.hideLoading()
    }
  }

  function formatClock(date: Date): string {
    const hours = date.getHours()
    const minutes = date.getMinutes()
    const h = hours < 10 ? '0' + hours.toString() : hours.toString()
    const m = minutes < 10 ? '0' + minutes.toString() : minutes.toString()
    return h + ':' + m
  }

  async function saveConfig() {
    persistRuntimeConfig()
    const validationMessage = validateAliOssRuntimeConfig(aliOssStorage.getRuntimeConfig())
    if (validationMessage.length > 0) {
      uni.showToast({
        title: validationMessage,
        icon: 'none'
      })
      return
    }

    uni.showLoading({
      title: '初始化OSS中...'
    })

    try {
      await connectAliOss()
      await initializeAliOssProfile()
      await new Promise(resolve => setTimeout(resolve, 1000))
      hydrateAuthView()
      uni.showToast({
        title: '保存并初始化成功',
        icon: 'success'
      })
      setTimeout(() => {
        uni.navigateBack()
      }, 1500)
    } catch (error) {
      console.error('Initialize OSS profile failed:', error)
      uni.showToast({
        title: String(error),
        icon: 'none'
      })
    } finally {
      uni.hideLoading()
    }
  }
</script>

