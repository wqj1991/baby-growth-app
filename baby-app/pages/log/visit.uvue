<template>
  <view class="page-root">
    <!-- Status Bar -->
    <view class="status-bar">
      <text class="status-time">10:54</text>
      <view class="status-icons">
        <view class="status-icon">
          <uni-icons type="signal" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="wifi" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="battery-full" :size="17" color="#1f2937"></uni-icons>
        </view>
      </view>
    </view>

    <!-- Main Content -->
    <scroll-view class="page-scroll" :show-scrollbar="false">
      <!-- Header -->
      <view class="header-violet">
        <view class="header-nav">
          <view class="nav-back" @tap="goBack">
            <uni-icons type="back" :size="20" color="#ffffff"></uni-icons>
          </view>
          <text class="nav-title">健康记录</text>
          <text class="nav-action">上传单据</text>
        </view>
        <view class="header-content">
          <text class="header-title">就诊记录</text>
          <text class="header-desc">记录医院、科室、医生建议和检查结果，方便后续复查和家庭共享。</text>
        </view>
      </view>

      <!-- Content Section -->
      <view class="content-section">
        <!-- Visit Info -->
        <view class="card">
          <text class="card-title">就诊信息</text>
          <view class="visit-info mt-3">
            <view class="hospital-grid">
              <view class="hospital-block hospital-block-active">
                <text class="info-label">医院</text>
                <text class="info-value">儿童医院</text>
              </view>
              <view class="hospital-block">
                <text class="info-label">科室</text>
                <text class="info-value">儿科门诊</text>
              </view>
            </view>
            <view class="conclusion-block">
              <text class="info-label">医生结论</text>
              <text class="conclusion-text">上呼吸道感染，建议继续观察体温并按时用药。</text>
            </view>
          </view>
        </view>

        <!-- Treatment -->
        <view class="card">
          <text class="card-title">处置与复查</text>
          <view class="treatment-tags mt-3">
            <view class="treatment-tag treatment-tag-active" @tap="toggleTreatment('已开药')">
              <text>已开药</text>
            </view>
            <view class="treatment-tag treatment-tag-active" @tap="toggleTreatment('复诊')">
              <text>3 天后复诊</text>
            </view>
            <view class="treatment-tag" @tap="toggleTreatment('多喝水')">
              <text>多喝水</text>
            </view>
          </view>
          <view class="notes-dashed mt-4">
            <text>备注：检查单、化验结果、医生口头建议等</text>
          </view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- Bottom Actions -->
    <view class="bottom-bar">
      <view class="btn btn-secondary" @tap="goBack">
        <text>取消</text>
      </view>
      <view class="btn btn-primary btn-wide" @tap="saveRecord">
        <text>保存就诊记录</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  let selectedTreatments = ref<string[]>(['已开药', '复诊'])

  function goBack() {
    uni.navigateBack()
  }

  function toggleTreatment(treatment: string) {
    const index = selectedTreatments.value.indexOf(treatment)
    if (index > -1) {
      selectedTreatments.value.splice(index, 1)
    } else {
      selectedTreatments.value.push(treatment)
    }
  }

  function saveRecord() {
    uni.showToast({
      title: '保存成功',
      icon: 'success'
    })
    setTimeout(() => {
      uni.switchTab({
        url: '/pages/home/index'
      })
    }, 1500)
  }
</script>

