</template>

<script setup lang="uts">
  import { recordItemStore } from '@/utils/store'

  const settings = recordItemStore.settings

  function navigateTo(url: string) {
    uni.navigateTo({
      url,
      fail: () => {
        uni.showToast({
          title: '页面开发中',
          icon: 'none'
        })
      }
    })
  }

  function handleCamera() {
    uni.chooseMedia({
      count: 9,
      mediaType: ['image', 'video'],
      sourceType: ['camera'],
      success: () => {
        uni.showToast({
          title: '拍照/录像功能开发中',
          icon: 'none'
        })
      },
      fail: () => {
        uni.showToast({
          title: '功能开发中',
          icon: 'none'
        })
      }
    })
  }

  function handleUpload() {
    uni.chooseMedia({
      count: 9,
      mediaType: ['image', 'video'],
      sourceType: ['album'],
      success: () => {
        uni.showToast({
          title: '本地上传功能开发中',
          icon: 'none'
        })
      },
      fail: () => {
        uni.showToast({
          title: '功能开发中',
          icon: 'none'
        })
      }
    })
  }

  function goFeedingLog() {
    navigateTo('/pages/log/feeding')
  }

  function goPottyLog() {
    navigateTo('/pages/log/potty')
  }

  function goSleepLog() {
    navigateTo('/pages/log/sleep')
  }

  function goGrowthLog() {
    navigateTo('/pages/log/growth')
  }

  function goHealthMoreLog() {
    navigateTo('/pages/log/health-more')
  }

  function showToast(title: string) {
    uni.showToast({
      title,
      icon: 'none'
    })
  }
</script>

