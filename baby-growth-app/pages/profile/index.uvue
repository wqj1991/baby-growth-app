<script setup lang="uts">
  function navigateTo(url: string) {
    uni.navigateTo({
      url,
      fail: () => {
        uni.showToast({
          title: '页面开发中',
          icon: 'none'
        })
      }
    })
  }

  function handleLogout() {
    uni.showModal({
      title: '提示',
      content: '确定要退出登录吗？',
      success: (res) => {
        if (res.confirm) {
          uni.showToast({
            title: '退出登录功能开发中',
            icon: 'none'
          })
        }
      }
    })
  }

  function showToast(title: string) {
    uni.showToast({
      title,
      icon: 'none'
    })
  }
</script>

