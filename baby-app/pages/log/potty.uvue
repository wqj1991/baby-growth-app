          <uni-icons type="wifi" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="battery-full" :size="17" color="#1f2937"></uni-icons>
        </view>
      </view>
    </view>

    <!-- Main Content -->
    <scroll-view class="page-scroll" :show-scrollbar="false">
      <!-- Header -->
      <view class="header-amber">
        <view class="header-nav">
          <view class="nav-back" @tap="goBack">
            <uni-icons type="back" :size="20" color="#ffffff"></uni-icons>
          </view>
          <text class="nav-title">日常护理</text>
          <text class="nav-action">模板</text>
        </view>
        <view class="header-content">
          <text class="header-title">大小便记录</text>
          <text class="header-desc">方便家人快速同步尿布情况，也便于观察规律变化。</text>
        </view>
      </view>

      <!-- Content Section -->
      <view class="content-section">
        <!-- Event Type -->
        <view class="card">
          <text class="card-title">事件类型</text>
          <view class="grid-2 mt-3">
            <view class="grid-btn grid-btn-active" @tap="selectType('pee')">
              <text>小便</text>
            </view>
            <view class="grid-btn" @tap="selectType('poop')">
              <text>大便</text>
            </view>
          </view>
        </view>

        <!-- Condition Selection -->
        <view class="card">
          <text class="card-title">情况选择</text>
          <view class="grid-3 mt-3">
            <view class="condition-btn condition-btn-active" @tap="selectCondition('normal')">
              <text>正常</text>
            </view>
            <view class="condition-btn" @tap="selectCondition('more')">
              <text>偏多</text>
            </view>
            <view class="condition-btn" @tap="selectCondition('less')">
              <text>偏少</text>
            </view>
            <view class="condition-btn" @tap="selectCondition('thin')">
              <text>偏稀</text>
            </view>
            <view class="condition-btn" @tap="selectCondition('hard')">
              <text>偏硬</text>
            </view>
            <view class="condition-btn" @tap="selectCondition('observe')">
              <text>需观察</text>
            </view>
          </view>
        </view>

        <!-- Diaper Time -->
        <view class="card">
          <view class="card-header">
            <text class="card-title">换尿布时间</text>
            <text class="card-badge">今天已记录 6 次</text>
          </view>
          <view class="time-card">
            <view class="time-row">
              <text class="time-label">最近一次</text>
              <text class="time-value">09:15</text>
            </view>
            <text class="current-time">10:38</text>
            <view class="progress-bar">
              <view class="progress-fill"></view>
            </view>
            <text class="time-note">距离上次间隔 1 小时 23 分钟</text>
          </view>
        </view>

        <!-- Additional Info -->
        <view class="card">
          <text class="card-title">附加信息</text>
          <view class="additional-list">
            <view class="additional-item">
              <text class="additional-label">是否红屁屁护理</text>
              <uni-icons type="switch" :size="28" color="#22c55e"></uni-icons>
            </view>
            <view class="additional-item">
              <text class="additional-label">是否拍照留档</text>
              <uni-icons type="switch" :size="28" color="#d1d5db"></uni-icons>
            </view>
            <view class="additional-item additional-item-dashed">
              <text class="additional-placeholder">补充描述：颜色、状态、是否更换品牌等</text>
            </view>
          </view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- Bottom Actions -->
    <view class="bottom-bar">
      <view class="btn btn-secondary" @tap="goBack">
        <text>取消</text>
      </view>
      <view class="btn btn-primary btn-wide" @tap="saveRecord">
        <text>保存护理记录</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  let selectedType = ref('pee')
  let selectedCondition = ref('normal')

  function goBack() {
    uni.navigateBack()
  }

  function selectType(type: string) {
    selectedType.value = type
  }

  function selectCondition(condition: string) {
    selectedCondition.value = condition
  }

  function saveRecord() {
    uni.showToast({
      title: '保存成功',
      icon: 'success'
    })
    setTimeout(() => {
      uni.switchTab({
        url: '/pages/home/index'
      })
    }, 1500)
  }
</script>

