    flex: 1;
    height: 100%;
    background-color: #fff1f2;
  }

  .status-bar {
    height: 40px;
    background-color: rgba(255, 255, 255, 0.8);
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0 16px;
    font-size: 14px;
