<template>
  <view class="page-root">
    <!-- Status Bar -->
    <view class="status-bar">
      <text class="status-time">10:53</text>
      <view class="status-icons">
        <view class="status-icon">
          <uni-icons type="signal" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="wifi" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="battery-three-quarters" :size="17" color="#1f2937"></uni-icons>
        </view>
      </view>
    </view>

    <!-- Main Content -->
    <scroll-view class="page-scroll" :show-scrollbar="false">
      <!-- Header -->
      <view class="header-amber">
        <view class="header-nav">
          <view class="nav-back" @tap="goBack">
            <uni-icons type="back" :size="20" color="#ffffff"></uni-icons>
          </view>
          <text class="nav-title">健康记录</text>
          <text class="nav-action">观察</text>
        </view>
        <view class="header-content">
          <text class="header-title">症状记录</text>
          <text class="header-desc">记录咳嗽、流涕、呕吐、皮疹等异常表现，方便连续观察。</text>
        </view>
      </view>

      <!-- Content Section -->
      <view class="content-section">
        <!-- Symptom Type -->
        <view class="card">
          <text class="card-title">症状类型</text>
          <view class="symptom-grid mt-3">
            <view class="symptom-btn symptom-btn-active" @tap="selectSymptom('咳嗽')">
              <text>咳嗽</text>
            </view>
            <view class="symptom-btn" @tap="selectSymptom('流涕')">
              <text>流涕</text>
            </view>
            <view class="symptom-btn" @tap="selectSymptom('呕吐')">
              <text>呕吐</text>
            </view>
            <view class="symptom-btn" @tap="selectSymptom('皮疹')">
              <text>皮疹</text>
            </view>
          </view>
        </view>

        <!-- Severity -->
        <view class="card">
          <view class="card-header">
            <text class="card-title">严重程度</text>
            <text class="card-badge">中度</text>
          </view>
          <view class="severity-display mt-3">
            <text class="severity-value">2 / 3</text>
            <slider class="severity-slider" min="1" max="3" value="2" @change="onSeverityChange" />
          </view>
        </view>

        <!-- Accompanying Symptoms -->
        <view class="card">
          <text class="card-title">伴随表现</text>
          <view class="accompany-tags mt-3">
            <view class="accompany-tag accompany-tag-active" @tap="toggleAccompany('夜里更明显')">
              <text>夜里更明显</text>
            </view>
            <view class="accompany-tag" @tap="toggleAccompany('影响睡眠')">
              <text>影响睡眠</text>
            </view>
            <view class="accompany-tag" @tap="toggleAccompany('食欲变差')">
              <text>食欲变差</text>
            </view>
          </view>
          <view class="notes-dashed mt-4">
            <text>备注：出现频率、持续时长、是否和发热一起出现</text>
          </view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- Bottom Actions -->
    <view class="bottom-bar">
      <view class="btn btn-secondary" @tap="goBack">
        <text>取消</text>
      </view>
      <view class="btn btn-primary btn-wide" @tap="saveRecord">
        <text>保存症状记录</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  let selectedSymptom = ref('咳嗽')
  let severity = ref(2)
  let selectedAccompanies = ref<string[]>(['夜里更明显'])

  function goBack() {
    uni.navigateBack()
  }

  function selectSymptom(symptom: string) {
    selectedSymptom.value = symptom
  }

  function onSeverityChange(e: { detail: { value: number } }) {
    severity.value = e.detail.value
  }

  function toggleAccompany(accompany: string) {
    const index = selectedAccompanies.value.indexOf(accompany)
    if (index > -1) {
      selectedAccompanies.value.splice(index, 1)
    } else {
      selectedAccompanies.value.push(accompany)
    }
  }

  function saveRecord() {
    uni.showToast({
      title: '保存成功',
      icon: 'success'
    })
    setTimeout(() => {
      uni.switchTab({
        url: '/pages/home/index'
      })
    }, 1500)
  }
</script>

<style>
