{
  "_comment": "双端共享数据模型规范 — Android/HarmonyOS 均以此为唯一数据定义来源",
  "version": 1,
  "models": {
    "AppConfig": {
      "version": "int",
      "cacheMaxBytes": "long (default: 2147483648)",
      "cacheAutoCleanDays": "int (default: 7)",
      "downloadPath": "enum: APP_ALBUM | SYSTEM_ALBUM",
      "wifiOnlyUpload": "bool (default: true)",
      "syncIntervalMinutes": "int (default: 10)",
      "familyMembers": "FamilyMember[]"
    },
    "FamilyMember": {
      "id": "uuid string",
      "nickname": "string",
      "role": "enum: PARENT | GRANDPARENT | OTHER"
    },
    "BabyProfile": {
      "id": "uuid string",
      "name": "string",
      "birthday": "ISO 8601 date (yyyy-MM-dd)",
      "gender": "enum: MALE | FEMALE | UNKNOWN",
      "avatarMediaId": "uuid string | null",
      "updatedAt": "ISO 8601 datetime",
      "updatedBy": "member id"
    },
    "CareLog": {
      "id": "uuid string",
      "type": "enum: FEEDING | POTTY | SLEEP | TEMPERATURE | VACCINE | VISIT | MEDICATION | GROWTH | CUSTOM",
      "babyId": "uuid string",
      "recordedAt": "unix millis",
      "recordedBy": "member id",
      "data": "object (type-specific fields, see careLogDataFields)",
      "note": "string | null",
      "mediaIds": "string[]",
      "createdAt": "unix millis",
      "updatedAt": "unix millis",
      "deleted": "bool"
    },
    "careLogDataFields": {
      "FEEDING":     { "feedingType": "BREAST|FORMULA|SOLID", "amountMl": "float|null", "durationMin": "int|null", "side": "L|R|BOTH|null" },
      "POTTY":       { "pottyType": "PEE|POO|BOTH", "color": "string|null", "consistency": "string|null" },
      "SLEEP":       { "startAt": "unix millis", "endAt": "unix millis|null", "durationMin": "int|null", "quality": "int 1-5|null" },
      "TEMPERATURE": { "valueCelsius": "float", "measureSite": "ARMPIT|RECTAL|EAR" },
      "VACCINE":     { "vaccineName": "string", "dose": "string|null", "site": "string|null", "nextDueDate": "ISO date|null" },
      "VISIT":       { "doctorName": "string|null", "hospital": "string|null", "diagnosis": "string|null", "nextVisitDate": "ISO date|null" },
      "MEDICATION":  { "medicationName": "string", "dosage": "string", "unit": "string", "frequency": "string" },
      "GROWTH":      { "weightKg": "float|null", "heightCm": "float|null", "headCircumferenceCm": "float|null" },
      "CUSTOM":      { "title": "string", "content": "string|null" }
    },
    "MediaItem": {
      "id": "uuid string",
      "type": "enum: PHOTO | VIDEO",
      "source": "enum: APP_SHOT | LOCAL_IMPORT | CLOUD_DOWNLOAD",
      "localRawPath": "string | null",
      "localPreviewPath": "string | null",
      "cloudRawPath": "string | null  (Phase 2)",
      "fileSizeBytes": "long",
      "durationSeconds": "int | null",
      "capturedAt": "unix millis",
      "uploadedAt": "unix millis | null  (Phase 2)",
      "babyId": "uuid string",
      "takenBy": "member id",
      "deleted": "bool"
    },
    "SyncTask": {
      "id": "uuid string",
      "action": "enum: UPLOAD | DOWNLOAD | DELETE",
      "resourceType": "enum: CONFIG | LOG | MEDIA",
      "resourceId": "uuid string",
      "localPath": "string | null",
      "remotePath": "string | null",
      "status": "enum: PENDING | IN_PROGRESS | DONE | FAILED",
      "retryCount": "int",
      "errorMessage": "string | null",
      "createdAt": "unix millis",
      "updatedAt": "unix millis"
    }
  }
}
