  }

  .symptom-btn-active {
    background-color: #f59e0b;
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(245, 158, 11, 0.3);
  }

  .severity-display {
    background-color: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 20px;
    padding: 16px;
    text-align: center;
  }

  .severity-value {
