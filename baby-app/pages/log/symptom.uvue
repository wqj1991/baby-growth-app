    display: flex;
    flex-direction: row;
  }

  .status-icon {
    margin-right: 8px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .page-scroll {
    flex: 1;
    height: 100%;
  }

  .header-amber {
    background: linear-gradient(135deg, #fbbf24 0%, #f97316 50%, #eab308 100%);
