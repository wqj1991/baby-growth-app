</template>

<script setup lang="uts">
  import { recordItemStore } from '@/utils/store'

  const settings = recordItemStore.settings

  function goBack() {
    uni.navigateBack()
  }

  function goHome() {
    uni.switchTab({
      url: '/pages/home/index'
    })
  }

  function getEnabledHealthCount() {
    return recordItemStore.getEnabledHealthCount()
  }

  function goTemperature() {
    uni.navigateTo({
      url: '/pages/log/temperature'
    })
  }

  function goMedication() {
    uni.navigateTo({
      url: '/pages/log/medication'
    })
  }

  function goVaccine() {
    uni.navigateTo({
      url: '/pages/log/vaccine'
    })
  }

  function goSymptom() {
    uni.navigateTo({
      url: '/pages/log/symptom'
    })
  }

  function goVisit() {
    uni.navigateTo({
      url: '/pages/log/visit'
    })
  }

  function goCustom() {
    uni.navigateTo({
      url: '/pages/log/custom-event'
    })
  }
</script>

