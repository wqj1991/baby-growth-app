<template>
  <view class="page-root">
    <!-- Status Bar -->
    <view class="status-bar">
      <text class="status-time">10:52</text>
      <view class="status-icons">
        <view class="status-icon">
          <uni-icons type="signal" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="wifi" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="battery-full" :size="17" color="#1f2937"></uni-icons>
        </view>
      </view>
    </view>

    <!-- Main Content -->
    <scroll-view class="page-scroll" :show-scrollbar="false">
      <!-- Header -->
      <view class="header-emerald">
        <view class="header-nav">
          <view class="nav-back" @tap="goBack">
            <uni-icons type="back" :size="20" color="#ffffff"></uni-icons>
          </view>
          <text class="nav-title">健康记录</text>
          <text class="nav-action">档案</text>
        </view>
        <view class="header-content">
          <text class="header-title">疫苗记录</text>
          <text class="header-desc">记录接种信息、接种点、批次以及接种后观察情况。</text>
        </view>
      </view>

      <!-- Content Section -->
      <view class="content-section">
        <!-- Vaccination Info -->
        <view class="card">
          <text class="card-title">接种信息</text>
          <view class="vaccine-info mt-3">
            <view class="vaccine-name-card">
              <text class="info-label">疫苗名称</text>
              <text class="info-value">13价肺炎疫苗</text>
            </view>
            <view class="vaccine-details">
              <view class="detail-block">
                <text class="info-label">接种日期</text>
                <text class="info-value">2026-04-28</text>
              </view>
              <view class="detail-block">
                <text class="info-label">批次号</text>
                <text class="info-value">PN-240428</text>
              </view>
            </view>
          </view>
        </view>

        <!-- Location and Dose -->
        <view class="card">
          <text class="card-title">接种地点与剂次</text>
          <view class="location-grid mt-3">
            <view class="location-block">
              <text class="info-label">接种点</text>
              <text class="info-value">社区卫生服务中心</text>
            </view>
            <view class="location-block">
              <text class="info-label">剂次</text>
              <text class="info-value">第 3 针</text>
            </view>
          </view>
        </view>

        <!-- Observation -->
        <view class="card">
          <text class="card-title">接种后观察</text>
          <view class="observe-tags mt-3">
            <view class="observe-tag observe-tag-active" @tap="toggleObserve('留观')">
              <text>已留观 30 分钟</text>
            </view>
            <view class="observe-tag" @tap="toggleObserve('红肿')">
              <text>针口轻微红</text>
            </view>
            <view class="observe-tag" @tap="toggleObserve('精神正常')">
              <text>精神正常</text>
            </view>
          </view>
          <view class="notes-dashed mt-4">
            <text>备注：接种禁忌、接种证照片、回访时间等</text>
          </view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- Bottom Actions -->
    <view class="bottom-bar">
      <view class="btn btn-secondary" @tap="goBack">
        <text>取消</text>
      </view>
      <view class="btn btn-primary btn-wide" @tap="saveRecord">
        <text>保存疫苗记录</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  let selectedObserves = ref<string[]>(['留观'])

  function goBack() {
    uni.navigateBack()
  }

  function toggleObserve(observe: string) {
    const index = selectedObserves.value.indexOf(observe)
    if (index > -1) {
      selectedObserves.value.splice(index, 1)
    } else {
      selectedObserves.value.push(observe)
    }
  }

  function saveRecord() {
    uni.showToast({
      title: '保存成功',
      icon: 'success'
    })
    setTimeout(() => {
      uni.switchTab({
        url: '/pages/home/index'
      })
    }, 1500)
  }
</script>

