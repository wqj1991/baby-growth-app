    margin-right: 8px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .page-scroll {
    flex: 1;
    height: 100%;
  }

  .header-rose {
    background: linear-gradient(135deg, #f43f5e 0%, #ef4444 50%, #f97316 100%);
    padding: 20px 20px 32px;
    border-radius: 0 0 32px 32px;
    box-shadow: 0 10px 25px rgba(244, 63, 94, 0.3);
  }

  .header-nav {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .nav-back {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.2);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .nav-title {
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 1px;
  }

