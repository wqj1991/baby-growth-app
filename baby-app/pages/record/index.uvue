          <uni-icons type="plusempty" :size="45" color="#ffffff"></uni-icons>
        </view>
      </navigator>
      <navigator class="tab-item" url="/pages/profile/index">
        <view class="tab-icon-wrap">
          <uni-icons type="person-filled" :size="22" color="#9ca3af"></uni-icons>
