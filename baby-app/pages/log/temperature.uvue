    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
  }

  .header-content {
    margin-top: 24px;
  }

  .header-title {
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
    display: block;
  }

  .header-desc {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 8px;
    display: block;
  }

  .content-section {
    padding: 0 16px;
    margin-top: -20px;
  }

  .card {
    background-color: #ffffff;
    border-radius: 24px;
    padding: 16px;
    margin-bottom: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .card-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .card-title {
    font-size: 14px;
    font-weight: 600;
    color: #111827;
