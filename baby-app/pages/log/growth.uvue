      <view class="content-section">
        <!-- Height & Weight Grid -->
        <view class="measure-grid">
          <view class="measure-card">
            <text class="measure-title">身高</text>
            <view class="measure-value-card measure-value-emerald">
              <text class="measure-value">78.5</text>
              <text class="measure-unit">cm</text>
            </view>
            <text class="measure-diff">较上次 +0.8 cm</text>
          </view>
          <view class="measure-card">
            <text class="measure-title">体重</text>
            <view class="measure-value-card measure-value-cyan">
              <text class="measure-value">10.6</text>
              <text class="measure-unit">kg</text>
            </view>
            <text class="measure-diff">较上次 +0.3 kg</text>
          </view>
        </view>

        <!-- Measure Status -->
        <view class="card">
          <view class="card-header">
            <text class="card-title">本次测量状态</text>
            <text class="card-badge">建议每周固定时间测量</text>
          </view>
          <view class="status-tags mt-3">
            <view class="status-tag status-tag-active" @tap="selectStatus('beforeMeal')">
              <text>饭前</text>
            </view>
            <view class="status-tag" @tap="selectStatus('afterMeal')">
              <text>饭后</text>
            </view>
            <view class="status-tag" @tap="selectStatus('justWokeUp')">
              <text>刚睡醒</text>
            </view>
            <view class="status-tag" @tap="selectStatus('calm')">
              <text>情绪稳定</text>
            </view>
          </view>
        </view>

        <!-- Growth Trend -->
        <view class="card">
          <text class="card-title">成长趋势</text>
          <view class="trend-chart">
            <view class="trend-bars">
              <view class="trend-bar" style="height: 50%"></view>
