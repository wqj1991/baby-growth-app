<template>
  <view class="page-root">
    <!-- Status Bar -->
    <view class="status-bar">
      <text class="status-time">10:55</text>
      <view class="status-icons">
        <view class="status-icon">
          <uni-icons type="signal" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="wifi" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="battery-three-quarters" :size="17" color="#1f2937"></uni-icons>
        </view>
      </view>
    </view>

    <!-- Main Content -->
    <scroll-view class="page-scroll" :show-scrollbar="false">
      <!-- Header -->
      <view class="header-slate">
        <view class="header-nav">
          <view class="nav-back" @tap="goBack">
            <uni-icons type="back" :size="20" color="#ffffff"></uni-icons>
          </view>
          <text class="nav-title">健康记录</text>
          <text class="nav-action">设为模板</text>
        </view>
        <view class="header-content">
          <text class="header-title">自定义事件</text>
          <text class="header-desc">用于记录未预置的健康事件，例如过敏、磕碰、夜间惊醒、换药反应等。</text>
        </view>
      </view>

      <!-- Content Section -->
      <view class="content-section">
        <!-- Event Name -->
        <view class="card">
          <text class="card-title">事件名称</text>
          <view class="event-name-card mt-3">
            <text class="info-label">标题</text>
            <text class="info-value">疑似草莓过敏</text>
          </view>
        </view>

        <!-- Event Tags -->
        <view class="card">
          <text class="card-title">事件标签</text>
          <view class="tag-list mt-3">
            <view class="tag tag-active" @tap="toggleTag('过敏')">
              <text>过敏</text>
            </view>
            <view class="tag" @tap="toggleTag('磕碰')">
              <text>磕碰</text>
            </view>
            <view class="tag" @tap="toggleTag('反应观察')">
              <text>反应观察</text>
            </view>
          </view>
        </view>

        <!-- Description -->
        <view class="card">
          <text class="card-title">详细描述</text>
          <view class="description-dashed mt-3">
            <text>例如：上午第一次吃草莓后，嘴周出现轻微红点，30 分钟后逐渐消退，无呕吐和喘息。</text>
          </view>
          <view class="detail-grid mt-4">
            <view class="detail-block">
              <text class="info-label">发生时间</text>
              <text class="info-value">10:20</text>
            </view>
            <view class="detail-block">
              <text class="info-label">风险级别</text>
              <text class="info-value">需持续观察</text>
            </view>
          </view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- Bottom Actions -->
    <view class="bottom-bar">
      <view class="btn btn-secondary" @tap="goBack">
        <text>取消</text>
      </view>
      <view class="btn btn-primary btn-wide" @tap="saveRecord">
        <text>保存自定义事件</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  let selectedTags = ref<string[]>(['过敏'])

  function goBack() {
    uni.navigateBack()
  }

  function toggleTag(tag: string) {
    const index = selectedTags.value.indexOf(tag)
    if (index > -1) {
      selectedTags.value.splice(index, 1)
    } else {
      selectedTags.value.push(tag)
    }
  }

  function saveRecord() {
    uni.showToast({
      title: '保存成功',
      icon: 'success'
    })
    setTimeout(() => {
      uni.switchTab({
        url: '/pages/home/index'
      })
    }, 1500)
  }
</script>

