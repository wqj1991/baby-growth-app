<template>
  <view class="page-root">
    <!-- Status Bar -->
    <view class="status-bar">
      <text class="status-time">10:46</text>
      <view class="status-icons">
        <view class="status-icon">
          <uni-icons type="signal" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="wifi" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="battery-full" :size="17" color="#1f2937"></uni-icons>
        </view>
      </view>
    </view>

    <!-- Main Content -->
    <scroll-view class="page-scroll" :show-scrollbar="false">
      <!-- Header -->
      <view class="header-rose">
        <view class="header-nav">
          <view class="nav-back" @tap="goBack">
            <uni-icons type="back" :size="20" color="#ffffff"></uni-icons>
          </view>
          <text class="nav-title">健康扩展记录</text>
          <text class="nav-action">帮助</text>
        </view>
        <view class="header-content">
          <text class="header-title">更多健康记录</text>
          <text class="header-desc">当喂养、睡眠、大小便之外还有其他需要追踪的健康事件时，在这里统一记录。</text>
        </view>
      </view>

      <!-- Content Section -->
      <view class="content-section">
        <!-- Record Types -->
        <view class="card">
          <view class="card-header">
            <view>
              <text class="card-title">适合记录什么</text>
              <text class="card-subtitle">按场景选择，后续会同步到首页动态和统计页</text>
            </view>
            <text class="card-badge">已启用 {{ getEnabledHealthCount() }} / 6</text>
          </view>
          <view class="type-grid mt-4">
            <view v-if="settings.temperature" class="type-card type-card-rose" @tap="goTemperature">
              <uni-icons type="thermometer" :size="20" color="#dc2626"></uni-icons>
              <text class="type-name">体温</text>
              <text class="type-desc">发热、退热后复测</text>
            </view>
            <view v-if="settings.medication" class="type-card type-card-sky" @tap="goMedication">
              <uni-icons type="pill" :size="20" color="#0284c7"></uni-icons>
              <text class="type-name">用药</text>
              <text class="type-desc">剂量、时间、频次</text>
            </view>
            <view v-if="settings.vaccine" class="type-card type-card-emerald" @tap="goVaccine">
              <uni-icons type="syringe" :size="20" color="#059669"></uni-icons>
              <text class="type-name">疫苗</text>
              <text class="type-desc">接种日期与批次</text>
            </view>
            <view v-if="settings.symptom" class="type-card type-card-amber" @tap="goSymptom">
              <uni-icons type="face-dizzy" :size="20" color="#d97706"></uni-icons>
              <text class="type-name">症状</text>
              <text class="type-desc">咳嗽、流涕、呕吐</text>
            </view>
            <view v-if="settings.visit" class="type-card type-card-violet" @tap="goVisit">
              <uni-icons type="notes-medical" :size="20" color="#7c3aed"></uni-icons>
              <text class="type-name">就诊</text>
              <text class="type-desc">医院、科室、结论</text>
            </view>
            <view v-if="settings.customEvent" class="type-card type-card-slate" @tap="goCustom">
              <uni-icons type="ellipsis" :size="20" color="#475569"></uni-icons>
              <text class="type-name">自定义</text>
              <text class="type-desc">例如过敏、磕碰</text>
            </view>
          </view>
        </view>

        <!-- How to Use -->
        <view class="card">
          <text class="card-title">如何使用</text>
          <view class="guide-list mt-4">
            <view class="guide-item">
              <view class="guide-number">1</view>
              <view class="guide-content">
                <text class="guide-step-title">先选记录类型</text>
                <text class="guide-step-desc">比如发热就选"体温"，吃药就选"用药"，去医院就选"就诊"。</text>
              </view>
            </view>
            <view class="guide-item">
              <view class="guide-number">2</view>
              <view class="guide-content">
                <text class="guide-step-title">填写关键字段</text>
                <text class="guide-step-desc">至少填写时间、数值或结论；如果有照片、处方单，也可以作为附件补充。</text>
              </view>
            </view>
            <view class="guide-item">
              <view class="guide-number">3</view>
              <view class="guide-content">
                <text class="guide-step-title">保存后自动归档</text>
                <text class="guide-step-desc">会自动进入时间轴，并可在统计页按健康事件回看变化趋势。</text>
              </view>
            </view>
          </view>
        </view>

        <!-- Example Cards -->
        <view class="card">
          <view class="card-header">
            <text class="card-title">示例卡片</text>
            <text class="card-action" @tap="goHome">查看首页效果</text>
          </view>
          <view class="example-list mt-4">
            <view class="example-card example-card-rose">
              <view class="example-info">
                <text class="example-title">体温记录</text>
                <text class="example-desc">今天 09:20，耳温 38.2°C，已服用退烧药</text>
              </view>
              <text class="example-tag">发热中</text>
            </view>
            <view class="example-card example-card-sky">
              <view class="example-info">
                <text class="example-title">用药记录</text>
                <text class="example-desc">今天 09:30，布洛芬 3ml，饭后服用</text>
              </view>
              <text class="example-tag">已提醒</text>
            </view>
          </view>
        </view>

        <!-- Templates -->
        <view class="card">
          <text class="card-title">常用模板</text>
          <view class="template-tags mt-3">
            <view class="template-tag template-tag-rose" @tap="useTemplate('fever')">
              <text>发热追踪</text>
            </view>
            <view class="template-tag template-tag-sky" @tap="useTemplate('antibiotic')">
              <text>抗生素用药</text>
            </view>
            <view class="template-tag template-tag-emerald" @tap="useTemplate('vaccine')">
              <text>疫苗回访</text>
            </view>
            <view class="template-tag template-tag-violet" @tap="useTemplate('checkup')">
