<template>
  <view class="page-root">
    <!-- Status Bar -->
    <view class="status-bar">
      <text class="status-time">10:51</text>
      <view class="status-icons">
        <view class="status-icon">
          <uni-icons type="signal" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="wifi" :size="15" color="#1f2937"></uni-icons>
        </view>
        <view class="status-icon">
          <uni-icons type="battery-three-quarters" :size="17" color="#1f2937"></uni-icons>
        </view>
      </view>
    </view>

    <!-- Main Content -->
    <scroll-view class="page-scroll" :show-scrollbar="false">
      <!-- Header -->
      <view class="header-sky">
        <view class="header-nav">
          <view class="nav-back" @tap="goBack">
            <uni-icons type="back" :size="20" color="#ffffff"></uni-icons>
          </view>
          <text class="nav-title">健康记录</text>
          <text class="nav-action">提醒</text>
        </view>
        <view class="header-content">
          <text class="header-title">用药记录</text>
          <text class="header-desc">记录药物名称、剂量、频次和服用后的状态，避免重复或漏服。</text>
        </view>
      </view>

      <!-- Content Section -->
      <view class="content-section">
        <!-- Drug Info -->
        <view class="card">
          <text class="card-title">药物信息</text>
          <view class="drug-info mt-3">
            <view class="drug-name-card">
              <text class="info-label">药名</text>
              <text class="info-value">布洛芬混悬液</text>
            </view>
            <view class="drug-details">
              <view class="detail-block">
                <text class="info-label">剂量</text>
                <text class="info-value">3 ml</text>
              </view>
              <view class="detail-block">
                <text class="info-label">服用时间</text>
                <text class="info-value">09:30</text>
              </view>
            </view>
          </view>
        </view>

        <!-- Medication Method -->
        <view class="card">
          <view class="card-header">
            <text class="card-title">用药方式</text>
            <text class="card-badge">按医嘱执行</text>
          </view>
          <view class="method-grid mt-3">
            <view class="method-btn method-btn-active" @tap="selectMethod('口服')">
              <text>口服</text>
            </view>
            <view class="method-btn" @tap="selectMethod('外用')">
              <text>外用</text>
            </view>
            <view class="method-btn" @tap="selectMethod('雾化')">
              <text>雾化</text>
            </view>
          </view>
          <view class="reminder-note mt-3">
            <text>下次提醒：13:30，可同步给家庭成员。</text>
          </view>
        </view>

        <!-- After Medication Status -->
        <view class="card">
          <text class="card-title">用药后状态</text>
          <view class="status-tags mt-3">
            <view class="status-tag status-tag-active" @tap="toggleStatus('退热中')">
              <text>退热中</text>
            </view>
            <view class="status-tag" @tap="toggleStatus('无明显不适')">
              <text>无明显不适</text>
            </view>
            <view class="status-tag" @tap="toggleStatus('食欲一般')">
              <text>食欲一般</text>
            </view>
          </view>
          <view class="notes-dashed mt-4">
            <text>备注：是否呕吐、是否吐药、是否需再次复测体温</text>
          </view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- Bottom Actions -->
    <view class="bottom-bar">
      <view class="btn btn-secondary" @tap="goBack">
        <text>取消</text>
      </view>
      <view class="btn btn-primary btn-wide" @tap="saveRecord">
        <text>保存用药记录</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  let selectedMethod = ref('口服')
  let selectedStatuses = ref<string[]>(['退热中'])

  function goBack() {
    uni.navigateBack()
  }

  function selectMethod(method: string) {
    selectedMethod.value = method
  }

  function toggleStatus(status: string) {
    const index = selectedStatuses.value.indexOf(status)
    if (index > -1) {
      selectedStatuses.value.splice(index, 1)
    } else {
      selectedStatuses.value.push(status)
    }
  }

  function saveRecord() {
    uni.showToast({
      title: '保存成功',
      icon: 'success'
    })
    setTimeout(() => {
      uni.switchTab({
        url: '/pages/home/index'
      })
    }, 1500)
  }
</script>

<style>
