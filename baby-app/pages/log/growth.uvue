</template>

<script setup lang="uts">
  let selectedStatus = ref('beforeMeal')

  function goBack() {
    uni.navigateBack()
  }

  function selectStatus(status: string) {
    selectedStatus.value = status
  }

  function saveRecord() {
    uni.showToast({
      title: '保存成功',
      icon: 'success'
    })
    setTimeout(() => {
      uni.switchTab({
        url: '/pages/home/index'
      })
    }, 1500)
  }
</script>

