<script setup lang="uts">
  import { ref } from 'vue'
  
  const showVideoModal = ref(false)
  const currentVideoUrl = ref('')
  const videoItem = ref({
    url: '/static/video.mp4',
    poster: '/static/shuijiao.jpg',
    duration: '0:32'
  })

  const navigateTo = (url: string) => {
    uni.navigateTo({
      url,
      fail: () => {
        uni.showToast({
          title: '页面开发中',
          icon: 'none'
        })
      }
    })
  }

  const showToast = (title: string) => {
    uni.showToast({
      title,
      icon: 'none'
    })
  }

  const onPreviewImage = (imageUrl: string) => {
    uni.previewImage({
      current: imageUrl,
      urls: [imageUrl],
      fail: () => {
        uni.showToast({
          title: '图片加载失败',
          icon: 'none'
        })
      }
    })
  }

  const handlePlayVideo = (videoUrl: string) => {
    currentVideoUrl.value = videoUrl
    showVideoModal.value = true
  }

  const closeVideoModal = () => {
    showVideoModal.value = false
    currentVideoUrl.value = ''
  }

  const onSearchClick = () => {
    showToast('搜索功能后续接入')
  }

  const onHomeTabClick = () => {
    showToast('当前位于首页')
  }

  const onRecordTabClick = () => {
    navigateTo('/pages/record/index')
  }

  const onProfileTabClick = () => {
    navigateTo('/pages/profile/index')
  }

  const onVideoPlay = () => {
    console.log('视频开始播放')
  }

  const onVideoPause = () => {
    console.log('视频暂停')
  }

</script>

