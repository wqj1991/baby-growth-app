<script setup lang="uts">
  function goBack() {
    uni.navigateBack()
  }

  function openGroup() {
    uni.showToast({
      title: '开发中',
      icon: 'none'
    })
  }

  function batchMove() {
    uni.showToast({
      title: '开发中',
      icon: 'none'
    })
  }

  function cleanDuplicates() {
    uni.showToast({
      title: '开发中',
      icon: 'none'
    })
  }

  function retrySync() {
    uni.showToast({
      title: '开发中',
      icon: 'none'
    })
  }

  function saveSettings() {
    uni.showToast({
      title: '保存成功',
      icon: 'success'
    })
    setTimeout(() => {
      uni.navigateBack()
    }, 1500)
  }
</script>

